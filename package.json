{
  "name": "tellux-earth",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "build:pages": "vite build",
    "build:pages:offline": "vite build && node scripts/export-static-cache.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "start": "node server.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:dom": "node scripts/generate-dom-ids.mjs",
    "check:conventions": "node scripts/check-conventions.mjs",
    "check": "npm run type-check && npm run lint && npm run format:check && npm run check:conventions && npm test",
    "verify": "node scripts/verify.mjs",
    "verify:ui": "node scripts/verify.mjs --ui",
    "test": "node tests/water-state.test.mjs",
    "cache:prefetch": "node scripts/cache-region.mjs",
    "cache:static": "node scripts/cache-static.mjs"
  },
  "dependencies": {
    "@takram/three-atmosphere": "0.19.1",
    "@takram/three-clouds": "0.7.6",
    "@takram/three-geospatial": "0.9.1",
    "@takram/three-geospatial-effects": "0.6.4",
    "3d-tiles-renderer": "^0.4.27",
    "postprocessing": "6.39.1",
    "tellux": "0.3.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.6",
    "@types/three": "^0.184.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "playwright-core": "^1.49.0",
    "prettier": "^3.10.1",
    "typescript": "~5.2.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8"
  }
}
