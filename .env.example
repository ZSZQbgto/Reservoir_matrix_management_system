# Tianditu tk used for imagery and swdx elv_c terrain. The key must have the
# "三维地形 / swdx" service enabled in the Tianditu console and the deployment
# origin in its domain whitelist.
TIANDITU_TOKEN=your_tianditu_token
TIANDITU_REFERER=https://your-registered-domain.example/

# Optional Cesium Ion token. When set, the app loads Cesium World Terrain
# (asset 1) and Cesium World Imagery (asset 2). Without it, the app uses
# ArcGIS World Imagery only.
CESIUM_ION_TOKEN=your_cesium_ion_token

# Optional Cesium quantized-mesh fallback used only when swdx is unavailable.
MAPTILER_KEY=your_maptiler_key

# auto | tianditu | maptiler
TERRAIN_MODE=auto

HOST=127.0.0.1
PORT=8090
